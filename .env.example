# Copy to .env and fill in keys. Free keys:
# TMDB: https://www.themoviedb.org/settings/api
# OMDb: https://www.omdbapi.com/apikey.aspx

TMDB_API_KEY=
OMDB_API_KEY=

# Optional Kinopoisk unofficial / kinopoiskapiunofficial.tech
KINOPOISK_API_KEY=

# Wikimedia OAuth (meta.wikimedia.org) — Wikipedia REST + API
# Create owner-only consumer / personal access token with scopes: basic, highvolume
WIKIMEDIA_CONTACT_EMAIL=
WIKIMEDIA_CLIENT_ID=
WIKIMEDIA_CLIENT_SECRET=
WIKIMEDIA_ACCESS_TOKEN=
# Optional rate overrides when token present
# WIKIPEDIA_RPM=40
# WIKIPEDIA_DELAY_SEC=1.5

# Politeness
REQUEST_DELAY_SEC=0.6
MAX_RETRIES=3
